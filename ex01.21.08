//Exercicio 1:

//Escreva um algoritmo que leia os elementos de uma matriz 5x5 de inteiros. Ao final, o algoritmo deverá mostrar quantos números são pares.//

programa {
  funcao inicio() {
    
    inteiro matriz[5][5]
    inteiro par = 0

    para(inteiro i = 0; i < 5; i ++){

      para(inteiro l = 0; l < 5; l ++){

        escreva("Insira um número para a posição: coluna " ,i + 1, "ª e linha " ,l + 1, "ª: " )
        leia(matriz[i][l])

        se(matriz[i][l] % 2 == 0){

          par ++
          
        }
      }
    }
    limpa()
    escreva ("Há " ,par, " números pares.")
      }
  }
